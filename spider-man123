def stats_printer():
    global start_time
    start_time = time.time()
    while not stop_flag:
        time.sleep(0.3)
        elapsed = time.time() - start_time
        speed = tried / elapsed if elapsed > 0 else 0
        status = f"\r\033[K{C_MAGENTA}🕷️ SPIDER{C_RESET} {C_CYAN}{speed:.1f}{C_RESET}c/s | {C_YELLOW}T:{tried}{C_RESET} | {C_GREEN}H:{len(hits)}{C_RESET} | {C_BOLD}{tried:06d}{C_RESET}"
        sys.stdout.write(status)
        sys.stdout.flush()

async def run_scanner(session_url, code_iter, workers):
    global _voucher_sem, stop_flag, _connector, tried, hits
    _init_ocr()
    tried, hits = 0, []
    stop_flag = False
    _connector = aiohttp.TCPConnector(limit=2000, ttl_dns_cache=300, ssl=False)
    _voucher_sem = asyncio.Semaphore(workers)

    stats_thread = threading.Thread(target=stats_printer, daemon=True)
    stats_thread.start()

    try:
        while not stop_flag:
            batch = []
            for _ in range(1000):
                try: batch.append(next(code_iter))
                except StopIteration: break
            if not batch: break
            async def _check(c):
                async with _voucher_sem: await perform_check(session_url, c)
            await asyncio.gather(*[_check(c) for c in batch], return_exceptions=True)
    except (asyncio.CancelledError, KeyboardInterrupt): stop_flag = True
    finally:
        stop_flag = True
        await _connector.close()
    print(f"\n{C_BOLD}{C_GREEN}[🕷️] Spider finished!{C_RESET}")

