def iter_custom_codes(lengths, charset):
    while not stop_flag:
        for length in lengths:
            yield "".join(random.choice(charset) for _ in range(length))

def iter_range_codes(start, end):
    digits = max(len(str(start)), len(str(end)))
    codes = [str(i).zfill(digits) for i in range(start, end + 1)]
    random.shuffle(codes)
    for c in codes: yield c

